# TikMusic Environment Configuration Example
# Sao chép file này thành .env.local trong môi trường phát triển

# 1. Bảo mật JWT (Bắt buộc - Chuỗi ngẫu nhiên tối thiểu 32 ký tự)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# 2. Cơ sở dữ liệu Turso LibSQL (Bắt buộc trên Production Vercel)
# Trên local development: Nếu không khai báo, hệ thống tự động dùng file SQLite tại ./data/tikmusic.db
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_secret

# 3. Môi trường hoạt động ('development' hoặc 'production')
NODE_ENV=development
